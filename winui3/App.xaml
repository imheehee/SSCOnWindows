<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="A2DPWBWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:A2DPWBWinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Design tokens (docs/dev/PLAN_DESIGN_CONSISTENCY.md, Faz C).
              Severity brushes are fixed (theme-agnostic) colors mirroring the CLI ANSI
              palette: INFO (default) | OK (green) | WARN (amber) | ERROR (red) | DATA (cyan).
              Texture/text-level tokens switch per theme via ThemeDictionaries.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#717171" />
                    <SolidColorBrush x:Key="StatusTextBrush" Color="#6D6D6D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="StatusTextBrush" Color="#B5B5B5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
              Severity state tokens (docs/dev/PLAN_UX_DESIGN.md Faz 3).

              The five states of the contract are: normal (default text colour),
              success, warning, error and info. "Info" is the Data/tag cyan.

              Every severity is stored as an explicit Light/Dark pair instead of one
              fixed colour: a single hex cannot stay readable in both themes. The
              dark values are the CLI ANSI palette; the light values are the same
              hues darkened until they clear WCAG AA (>= 4.5:1) on a light surface.

              Keys carry the theme suffix because TagBrush() in MainWindow.xaml.cpp
              resolves them in code - a plain ResourceDictionary.TryLookup() cannot
              see ResourceDictionary.ThemeDictionaries under C++/WinRT. These are
              shared, long-lived brush instances: the theme handler recolours them
              in place, so everything already holding a brush (including every log
              line) follows the theme without being touched.
            -->
            <SolidColorBrush x:Key="TagOkBrushLight"    Color="#1A7F37" />
            <SolidColorBrush x:Key="TagOkBrushDark"     Color="#3FB950" />
            <SolidColorBrush x:Key="TagWarnBrushLight"  Color="#9A6700" />
            <SolidColorBrush x:Key="TagWarnBrushDark"   Color="#D29922" />
            <SolidColorBrush x:Key="TagErrorBrushLight" Color="#CF222E" />
            <SolidColorBrush x:Key="TagErrorBrushDark"  Color="#F85149" />
            <SolidColorBrush x:Key="TagDataBrushLight"  Color="#0E7490" />
            <SolidColorBrush x:Key="TagDataBrushDark"   Color="#39B9D2" />

            <!-- Typography scale (Faz B/C) -->
            <Style x:Key="SectionLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionGrayTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
            </Style>
            <Style x:Key="HintGrayTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
            </Style>
            <Style x:Key="StatsValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="MonoLogTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Control consistency (uniform height / min-width / padding) -->
            <Style x:Key="AppButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>